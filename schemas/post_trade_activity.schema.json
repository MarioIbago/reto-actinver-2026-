{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/post_trade_activity.schema.json",
  "title": "Operator-entered manual activity for M9 attribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activity_id", "report_id", "captured_at_utc", "starting_capital_actipesos", "ending_capital_actipesos", "net_external_flows_actipesos", "manual_fills", "source_reference"],
  "properties": {
    "schema_version": {"const": 1},
    "activity_id": {"type": "string", "minLength": 1},
    "report_id": {"type": "string", "format": "uuid"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "starting_capital_actipesos": {"type": "number", "minimum": 0},
    "ending_capital_actipesos": {"type": "number", "minimum": 0},
    "net_external_flows_actipesos": {"type": "number"},
    "source_reference": {"type": "string", "minLength": 1},
    "manual_fills": {"type": "array", "items": {"$ref": "#/$defs/fill"}}
  },
  "$defs": {
    "fill": {
      "type": "object", "additionalProperties": false,
      "required": ["fill_id", "instrument_id", "side", "quantity", "price_actipesos", "fees_actipesos", "executed_at_utc"],
      "properties": {
        "fill_id": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["BUY", "SELL"]},
        "quantity": {"type": "number", "exclusiveMinimum": 0},
        "price_actipesos": {"type": "number", "exclusiveMinimum": 0},
        "fees_actipesos": {"type": "number", "minimum": 0},
        "executed_at_utc": {"type": "string", "format": "date-time"}
      }
    }
  }
}
