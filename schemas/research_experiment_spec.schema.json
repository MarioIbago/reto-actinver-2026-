{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/research_experiment_spec.schema.json",
  "title": "M5 pre-registered ExperimentSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "hypothesis", "strategy_family", "dataset_version",
    "universe_version", "features", "target", "horizon", "parameters", "train_period",
    "validation_period", "test_period", "transaction_cost_model", "execution_model",
    "benchmark_trial_id", "promotion_criteria", "seed", "commit_sha", "periods_per_year",
    "attempted_trial_count", "validation_protocol", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "strategy_family": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string", "minLength": 1},
    "features": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target": {"type": "string", "minLength": 1},
    "horizon": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "parameters", "parameter_sha256"],
        "properties": {
          "trial_id": {"type": "string", "minLength": 1},
          "parameters": {
            "type": "object",
            "propertyNames": {"minLength": 1},
            "additionalProperties": {
              "anyOf": [
                {"type": "string"}, {"type": "integer"}, {"type": "boolean"}, {"type": "null"}
              ]
            }
          },
          "parameter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "train_period": {"$ref": "validation_case.schema.json#/$defs/period"},
    "validation_period": {"$ref": "validation_case.schema.json#/$defs/period"},
    "test_period": {"$ref": "validation_case.schema.json#/$defs/period"},
    "transaction_cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_id", "commission_rate", "iva_rate_on_commission", "slippage_bps_per_side", "turnover_definition"],
      "properties": {
        "ruleset_id": {"type": "string", "minLength": 1},
        "commission_rate": {"$ref": "validation_case.schema.json#/$defs/nonNegativeDecimal"},
        "iva_rate_on_commission": {"$ref": "validation_case.schema.json#/$defs/nonNegativeDecimal"},
        "slippage_bps_per_side": {"type": "array", "minItems": 1, "items": {"$ref": "validation_case.schema.json#/$defs/nonNegativeDecimal"}},
        "turnover_definition": {"type": "string", "minLength": 1}
      }
    },
    "execution_model": {"type": "string", "minLength": 1},
    "benchmark_trial_id": {"type": "string", "minLength": 1},
    "promotion_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_test_sessions", "minimum_test_sharpe", "minimum_test_cumulative_return", "minimum_improvement_vs_benchmark", "minimum_dsr_probability", "maximum_pbo_probability", "maximum_test_drawdown"],
      "properties": {
        "minimum_test_sessions": {"type": "integer", "minimum": 1},
        "minimum_test_sharpe": {"$ref": "validation_case.schema.json#/$defs/decimal"},
        "minimum_test_cumulative_return": {"$ref": "validation_case.schema.json#/$defs/decimal"},
        "minimum_improvement_vs_benchmark": {"$ref": "validation_case.schema.json#/$defs/decimal"},
        "minimum_dsr_probability": {"$ref": "validation_case.schema.json#/$defs/nonNegativeDecimal"},
        "maximum_pbo_probability": {"$ref": "validation_case.schema.json#/$defs/nonNegativeDecimal"},
        "maximum_test_drawdown": {"$ref": "validation_case.schema.json#/$defs/nonNegativeDecimal"}
      }
    },
    "seed": {"type": "integer", "minimum": 0},
    "commit_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "periods_per_year": {"type": "integer", "minimum": 1},
    "attempted_trial_count": {"type": "integer", "minimum": 1},
    "validation_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "walk_forward", "pbo"],
      "properties": {
        "bootstrap": {"type": "object"},
        "walk_forward": {"type": "object"},
        "pbo": {"type": "object"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_status", "source_availability_verified", "instrument_mapping_verified", "m3_execution_evidence_verified", "costs_verified", "final_holdout_locked", "test_used_for_selection", "dataset_manifest_sha256", "m3_result_sha256"],
      "properties": {
        "data_status": {"enum": ["synthetic_fixture", "authorized_point_in_time", "unverified"]},
        "source_availability_verified": {"type": "boolean"},
        "instrument_mapping_verified": {"type": "boolean"},
        "m3_execution_evidence_verified": {"type": "boolean"},
        "costs_verified": {"type": "boolean"},
        "final_holdout_locked": {"type": "boolean"},
        "test_used_for_selection": {"type": "boolean"},
        "dataset_manifest_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
        "m3_result_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
      }
    }
  }
}
