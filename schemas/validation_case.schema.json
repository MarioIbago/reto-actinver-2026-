{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/validation_case.schema.json",
  "title": "M4 time-aware validation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "hypothesis", "dataset_version",
    "universe_version", "commit_sha", "seed", "periods_per_year", "evidence",
    "train_period", "validation_period", "test_period", "bootstrap",
    "walk_forward", "pbo", "cost_sensitivity_bps", "benchmark_trial_id",
    "attempted_trial_count", "promotion_criteria", "trials"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string", "minLength": 1},
    "commit_sha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "seed": {"type": "integer", "minimum": 0},
    "periods_per_year": {"type": "integer", "minimum": 1, "maximum": 10000},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_status", "source_availability_verified", "instrument_mapping_verified",
        "m3_execution_evidence_verified", "costs_verified", "final_holdout_locked",
        "test_used_for_selection", "dataset_manifest_sha256", "m3_result_sha256"
      ],
      "properties": {
        "data_status": {"enum": ["synthetic_fixture", "authorized_point_in_time", "unverified"]},
        "source_availability_verified": {"type": "boolean"},
        "instrument_mapping_verified": {"type": "boolean"},
        "m3_execution_evidence_verified": {"type": "boolean"},
        "costs_verified": {"type": "boolean"},
        "final_holdout_locked": {"type": "boolean"},
        "test_used_for_selection": {"type": "boolean"},
        "dataset_manifest_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
        "m3_result_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}
      }
    },
    "train_period": {"$ref": "#/$defs/period"},
    "validation_period": {"$ref": "#/$defs/period"},
    "test_period": {"$ref": "#/$defs/period"},
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "block_length", "confidence_level"],
      "properties": {
        "iterations": {"type": "integer", "minimum": 100, "maximum": 10000},
        "block_length": {"type": "integer", "minimum": 1},
        "confidence_level": {"$ref": "#/$defs/probability"}
      }
    },
    "walk_forward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "train_sessions", "evaluation_sessions", "step_sessions"],
      "properties": {
        "mode": {"enum": ["expanding", "rolling"]},
        "train_sessions": {"type": "integer", "minimum": 1},
        "evaluation_sessions": {"type": "integer", "minimum": 1},
        "step_sessions": {"type": "integer", "minimum": 1}
      }
    },
    "pbo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks"],
      "properties": {"blocks": {"type": "integer", "minimum": 4, "maximum": 12, "multipleOf": 2}}
    },
    "cost_sensitivity_bps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonNegativeDecimal"}
    },
    "benchmark_trial_id": {"type": "string", "minLength": 1},
    "attempted_trial_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "promotion_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_test_sessions", "minimum_test_sharpe", "minimum_test_cumulative_return",
        "minimum_improvement_vs_benchmark", "minimum_dsr_probability",
        "maximum_pbo_probability", "maximum_test_drawdown"
      ],
      "properties": {
        "minimum_test_sessions": {"type": "integer", "minimum": 1},
        "minimum_test_sharpe": {"$ref": "#/$defs/decimal"},
        "minimum_test_cumulative_return": {"$ref": "#/$defs/decimal"},
        "minimum_improvement_vs_benchmark": {"$ref": "#/$defs/decimal"},
        "minimum_dsr_probability": {"$ref": "#/$defs/probability"},
        "maximum_pbo_probability": {"$ref": "#/$defs/probability"},
        "maximum_test_drawdown": {"$ref": "#/$defs/probability"}
      }
    },
    "trials": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/trial"}
    }
  },
  "$defs": {
    "decimal": {
      "anyOf": [
        {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        {"type": "integer"}
      ]
    },
    "nonNegativeDecimal": {
      "anyOf": [
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "probability": {
      "anyOf": [
        {"type": "string", "pattern": "^(?:0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"},
        {"type": "integer", "enum": [0, 1]}
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_id", "parameters", "parameter_sha256", "returns"],
      "properties": {
        "trial_id": {"type": "string", "minLength": 1},
        "parameters": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "anyOf": [
              {"type": "string"},
              {"type": "integer"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          }
        },
        "parameter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "returns": {
          "type": "array",
          "items": {"$ref": "#/$defs/returnRow"}
        }
      }
    },
    "returnRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "gross_return", "turnover", "regime"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "gross_return": {"$ref": "#/$defs/decimal"},
        "turnover": {"$ref": "#/$defs/nonNegativeDecimal"},
        "regime": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    }
  }
}
