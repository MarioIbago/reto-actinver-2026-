{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/post_trade_attribution.schema.json",
  "title": "M9 descriptive post-activity attribution result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attribution_version", "attribution_id", "report_id", "report_sha256", "activity_id", "created_at_utc", "captured_at_utc", "source_reference", "starting_capital_actipesos", "ending_capital_actipesos", "net_external_flows_actipesos", "net_portfolio_change_actipesos", "net_portfolio_return", "manual_fill_count", "manual_fill_notional_actipesos", "reported_fees_actipesos", "linked_m9_action", "activity_vs_m9", "causal_strategy_contribution_actipesos", "p_final_rank_1_contribution", "attribution_status", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "attribution_version": {"const": "1.0.0"},
    "attribution_id": {"type": "string", "format": "uuid"},
    "report_id": {"type": "string", "format": "uuid"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activity_id": {"type": "string", "minLength": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "source_reference": {"type": "string", "minLength": 1},
    "starting_capital_actipesos": {"type": "number", "minimum": 0},
    "ending_capital_actipesos": {"type": "number", "minimum": 0},
    "net_external_flows_actipesos": {"type": "number"},
    "net_portfolio_change_actipesos": {"type": "number"},
    "net_portfolio_return": {"anyOf": [{"type": "number"}, {"type": "null"}]},
    "manual_fill_count": {"type": "integer", "minimum": 0},
    "manual_fill_notional_actipesos": {"type": "number", "minimum": 0},
    "reported_fees_actipesos": {"type": "number", "minimum": 0},
    "linked_m9_action": {"const": "NO_TRADE"},
    "activity_vs_m9": {"enum": ["NO_FILL_REPORTED", "MANUAL_ACTIVITY_WITHOUT_VALIDATED_M9_INSTRUCTION"]},
    "causal_strategy_contribution_actipesos": {"type": "null"},
    "p_final_rank_1_contribution": {"type": "null"},
    "attribution_status": {"const": "DESCRIPTIVE_ONLY"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
