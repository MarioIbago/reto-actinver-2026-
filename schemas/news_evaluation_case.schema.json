{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/news_evaluation_case.schema.json",
  "title": "Time-aware event prediction evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "target_definition", "horizon_sessions", "baseline_description", "train_period", "validation_period", "test_period", "final_holdout_locked", "test_used_for_selection", "evidence", "observations"],
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}
    },
    "decimal": {"type": ["string", "integer"]},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_status", "source_availability_verified", "instrument_mapping_verified", "prices_authorized", "execution_costs_verified"],
      "properties": {
        "data_status": {"enum": ["synthetic_fixture", "authorized_point_in_time", "unverified"]},
        "source_availability_verified": {"type": "boolean"},
        "instrument_mapping_verified": {"type": "boolean"},
        "prices_authorized": {"type": "boolean"},
        "execution_costs_verified": {"type": "boolean"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_group_id", "instrument_id", "feature_available_time", "prediction_available_time", "decision_time", "label_available_time", "label_id", "split", "forward_return", "event_probability"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "event_group_id": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "feature_available_time": {"type": "string", "format": "date-time"},
        "prediction_available_time": {"type": "string", "format": "date-time"},
        "decision_time": {"type": "string", "format": "date-time"},
        "label_available_time": {"type": "string", "format": "date-time"},
        "label_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "validation", "test"]},
        "forward_return": {"$ref": "#/$defs/decimal"},
        "event_probability": {"$ref": "#/$defs/decimal"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "target_definition": {"const": "gross_forward_return_gt_zero"},
    "horizon_sessions": {"type": "integer", "minimum": 1},
    "baseline_description": {"type": "string", "minLength": 1},
    "train_period": {"$ref": "#/$defs/period"},
    "validation_period": {"$ref": "#/$defs/period"},
    "test_period": {"$ref": "#/$defs/period"},
    "final_holdout_locked": {"const": true},
    "test_used_for_selection": {"const": false},
    "evidence": {"$ref": "#/$defs/evidence"},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  }
}
