{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/execution_case.schema.json",
  "title": "M3 deterministic execution case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "simulation_start",
    "simulation_as_of",
    "initial_cash_actipesos",
    "initial_positions",
    "prior_purchase_notional_actipesos",
    "prior_traded_share_ids",
    "orders",
    "market_trades",
    "cancellations",
    "market_data_dataset_id",
    "order_expiration_basis"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "simulation_start": {"$ref": "#/$defs/zonedTimestamp"},
    "simulation_as_of": {"$ref": "#/$defs/zonedTimestamp"},
    "initial_cash_actipesos": {"$ref": "#/$defs/exactNonNegativeDecimal"},
    "initial_positions": {
      "type": "array",
      "items": {"$ref": "#/$defs/position"}
    },
    "prior_purchase_notional_actipesos": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/exactNonNegativeDecimal"}
    },
    "prior_traded_share_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "orders": {
      "type": "array",
      "items": {"$ref": "#/$defs/order"}
    },
    "market_trades": {
      "type": "array",
      "items": {"$ref": "#/$defs/marketTrade"}
    },
    "cancellations": {
      "type": "array",
      "items": {"$ref": "#/$defs/cancellation"}
    },
    "market_data_dataset_id": {"type": "string", "minLength": 1},
    "order_expiration_basis": {"const": "explicit_timestamp"}
  },
  "$defs": {
    "zonedTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "exactPositiveDecimal": {
      "anyOf": [
        {"type": "string", "pattern": "^(?=.*[1-9])(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        {"type": "integer", "minimum": 1}
      ]
    },
    "exactNonNegativeDecimal": {
      "anyOf": [
        {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "quantity", "mark_price_actipesos", "marked_at"],
      "properties": {
        "instrument_id": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 0},
        "mark_price_actipesos": {
          "anyOf": [{"$ref": "#/$defs/exactPositiveDecimal"}, {"type": "null"}]
        },
        "marked_at": {"$ref": "#/$defs/zonedTimestamp"}
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "instrument_id", "side", "order_type", "quantity", "submitted_at", "expires_at", "sequence"],
      "properties": {
        "order_id": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "side": {"enum": ["buy", "sell"]},
        "order_type": {"enum": ["market", "limit"]},
        "quantity": {"type": "integer", "minimum": 1},
        "submitted_at": {"$ref": "#/$defs/zonedTimestamp"},
        "expires_at": {"$ref": "#/$defs/zonedTimestamp"},
        "sequence": {"type": "integer", "minimum": 0},
        "limit_price_actipesos": {"$ref": "#/$defs/exactPositiveDecimal"},
        "buying_power_reference_price_actipesos": {"$ref": "#/$defs/exactPositiveDecimal"}
      }
    },
    "marketTrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trade_id", "instrument_id", "traded_at", "price_actipesos", "sequence", "source_id", "source_revision"],
      "properties": {
        "trade_id": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "traded_at": {"$ref": "#/$defs/zonedTimestamp"},
        "price_actipesos": {"$ref": "#/$defs/exactPositiveDecimal"},
        "sequence": {"type": "integer", "minimum": 0},
        "source_id": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order_id", "cancelled_at", "sequence"],
      "properties": {
        "order_id": {"type": "string", "minLength": 1},
        "cancelled_at": {"$ref": "#/$defs/zonedTimestamp"},
        "sequence": {"type": "integer", "minimum": 0}
      }
    }
  }
}
