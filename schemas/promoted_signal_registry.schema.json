{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/promoted_signal_registry.schema.json",
  "title": "M7 feature and promoted-signal registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "signals"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string", "minLength": 1},
    "signals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/signal"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "experiment_id", "hypothesis_id", "promotion_record_sha256", "family_id", "source_type", "feature_ids", "dataset_id", "dataset_sha256", "universe_version", "target", "transaction_cost_model_sha256", "forecast_artifact_sha256", "horizon", "horizon_sessions"],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "experiment_id": {"type": "string", "minLength": 1},
        "hypothesis_id": {"type": "string", "minLength": 1},
        "promotion_record_sha256": {"$ref": "#/$defs/sha256"},
        "family_id": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["deterministic", "statistical", "quantified_event", "other_quantitative"]},
        "feature_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "dataset_id": {"type": "string", "minLength": 1},
        "dataset_sha256": {"$ref": "#/$defs/sha256"},
        "universe_version": {"type": "string", "minLength": 1},
        "target": {"const": "instrument_forward_return_net_of_costs"},
        "transaction_cost_model_sha256": {"$ref": "#/$defs/sha256"},
        "forecast_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "horizon": {"type": "string", "minLength": 1},
        "horizon_sessions": {"type": "integer", "minimum": 1}
      }
    }
  }
}
