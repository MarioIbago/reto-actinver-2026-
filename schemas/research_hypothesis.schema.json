{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/research_hypothesis.schema.json",
  "title": "M5 falsifiable research hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_id", "statement", "rationale", "source_references", "falsification_plan"],
  "properties": {
    "schema_version": {"const": 1},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "source_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "falsification_plan": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "approach", "required"],
        "properties": {
          "category": {"enum": ["leakage", "regime", "outliers", "parameter_sensitivity", "liquidity", "costs", "sample_size", "multiple_testing"]},
          "approach": {"type": "string", "minLength": 1},
          "required": {"const": true}
        }
      }
    }
  }
}
