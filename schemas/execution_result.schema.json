{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/execution_result.schema.json",
  "title": "M3 deterministic execution result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "ruleset_id",
    "universe_snapshot_id",
    "market_data_dataset_id",
    "simulation_start",
    "simulation_as_of",
    "order_expiration_basis",
    "fill_policy",
    "orders",
    "ledger",
    "positions",
    "balances",
    "fees",
    "eligibility_checks",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "ruleset_id": {"type": "string", "minLength": 1},
    "universe_snapshot_id": {"type": "string", "minLength": 1},
    "market_data_dataset_id": {"type": "string", "minLength": 1},
    "simulation_start": {"$ref": "#/$defs/zonedTimestamp"},
    "simulation_as_of": {"$ref": "#/$defs/zonedTimestamp"},
    "order_expiration_basis": {"type": "string"},
    "fill_policy": {"type": "string"},
    "orders": {"type": "array", "items": {"type": "object"}},
    "ledger": {"type": "array", "items": {"type": "object"}},
    "positions": {"type": "array", "items": {"type": "object"}},
    "balances": {
      "type": "object",
      "required": ["initial_cash_actipesos", "ending_cash_actipesos", "reserved_buying_power_actipesos", "available_buying_power_actipesos", "portfolio_value_actipesos"],
      "properties": {
        "initial_cash_actipesos": {"$ref": "#/$defs/decimalText"},
        "ending_cash_actipesos": {"$ref": "#/$defs/decimalText"},
        "reserved_buying_power_actipesos": {"$ref": "#/$defs/decimalText"},
        "available_buying_power_actipesos": {"$ref": "#/$defs/decimalText"},
        "portfolio_value_actipesos": {"$ref": "#/$defs/decimalText"}
      }
    },
    "fees": {
      "type": "object",
      "required": ["commission_rate", "iva_rate_on_commission", "combined_rate", "total_commission_actipesos", "total_iva_actipesos", "rounding_applied"],
      "properties": {
        "commission_rate": {"$ref": "#/$defs/decimalText"},
        "iva_rate_on_commission": {"$ref": "#/$defs/decimalText"},
        "combined_rate": {"$ref": "#/$defs/decimalText"},
        "total_commission_actipesos": {"$ref": "#/$defs/decimalText"},
        "total_iva_actipesos": {"$ref": "#/$defs/decimalText"},
        "rounding_applied": {"const": false}
      }
    },
    "eligibility_checks": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "run_provenance": {"type": "object"}
  },
  "$defs": {
    "zonedTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "decimalText": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"}
  }
}
