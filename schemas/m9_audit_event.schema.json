{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/m9_audit_event.schema.json",
  "title": "M9 append-only audit event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at_utc", "event_type", "object_id", "object_sha256", "previous_event_sha256", "event_sha256"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "occurred_at_utc": {"type": "string", "format": "date-time"},
    "event_type": {"enum": ["TRADE_SHEET_CREATED", "POST_TRADE_ATTRIBUTION_CREATED"]},
    "object_id": {"type": "string", "minLength": 1},
    "object_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_event_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
