{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/tournament_case.schema.json",
  "title": "M8 point-in-time tournament scenario case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "decision_at_utc", "ruleset_id", "universe_version", "transaction_cost_model_sha256", "m7_result_sha256", "tournament_state", "portfolio_state", "ruin_floor_actipesos", "evidence", "scenario_models", "optimizer"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "decision_at_utc": {"type": "string", "format": "date-time"},
    "ruleset_id": {"type": "string", "minLength": 1},
    "universe_version": {"type": "string", "minLength": 1},
    "transaction_cost_model_sha256": {"$ref": "#/$defs/sha256"},
    "m7_result_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "tournament_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_competitor_id", "current_capital_actipesos", "sessions_remaining", "total_sessions", "leaderboard_snapshot"],
      "properties": {
        "subject_competitor_id": {"type": "string", "minLength": 1},
        "current_capital_actipesos": {"type": "number", "exclusiveMinimum": 0},
        "sessions_remaining": {"type": "integer", "minimum": 1},
        "total_sessions": {"type": "integer", "minimum": 1},
        "leaderboard_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["as_of_utc", "complete", "competitors"],
          "properties": {
            "as_of_utc": {"type": "string", "format": "date-time"},
            "complete": {"type": "boolean"},
            "competitors": {"type": "array", "items": {"$ref": "#/$defs/competitor"}}
          }
        }
      }
    },
    "portfolio_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash_actipesos", "holdings", "traded_instrument_ids", "cumulative_purchase_value_actipesos_by_instrument"],
      "properties": {
        "cash_actipesos": {"type": "number", "minimum": 0},
        "holdings": {"type": "array", "items": {"$ref": "#/$defs/holding"}},
        "traded_instrument_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cumulative_purchase_value_actipesos_by_instrument": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
      }
    },
    "ruin_floor_actipesos": {"type": "number", "exclusiveMinimum": 0},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_type", "alpha_source_available_at_utc", "scenario_source_available_at_utc", "leaderboard_source_available_at_utc", "final_holdout_locked", "source_manifest_sha256"],
      "properties": {
        "sample_type": {"enum": ["authorized_point_in_time", "synthetic_fixture"]},
        "alpha_source_available_at_utc": {"type": "string", "format": "date-time"},
        "scenario_source_available_at_utc": {"type": "string", "format": "date-time"},
        "leaderboard_source_available_at_utc": {"type": "string", "format": "date-time"},
        "final_holdout_locked": {"const": true},
        "source_manifest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "scenario_models": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/scenario_model"}},
    "optimizer": {"$ref": "#/$defs/optimizer"},
    "candidate_portfolios": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "competitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competitor_id", "current_capital_actipesos"],
      "properties": {"competitor_id": {"type": "string", "minLength": 1}, "current_capital_actipesos": {"type": "number", "exclusiveMinimum": 0}}
    },
    "holding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "market_value_actipesos"],
      "properties": {"instrument_id": {"type": "string", "minLength": 1}, "market_value_actipesos": {"type": "number", "minimum": 0}}
    },
    "scenario_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "fit_cutoff_utc", "scenario_horizon_sessions", "return_basis", "source_sha256", "selection_scenarios", "holdout_scenarios"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "fit_cutoff_utc": {"type": "string", "format": "date-time"},
        "scenario_horizon_sessions": {"type": "integer", "minimum": 1},
        "return_basis": {"const": "net_of_costs"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "selection_scenarios": {"$ref": "#/$defs/scenarios"},
        "holdout_scenarios": {"$ref": "#/$defs/scenarios"}
      }
    },
    "scenarios": {"type": "array", "minItems": 2, "maxItems": 5000, "items": {"$ref": "#/$defs/scenario"}},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "probability", "asset_net_returns", "competitor_returns"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "asset_net_returns": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "exclusiveMinimum": -1}},
        "competitor_returns": {"type": "object", "additionalProperties": {"type": "number", "exclusiveMinimum": -1}}
      }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "candidate_count", "max_active_positions", "holdout_draws", "late_stage_fraction", "defend_p1_tolerance", "catch_up_p1_tolerance"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 2000},
        "max_active_positions": {"type": "integer", "minimum": 5, "maximum": 207},
        "holdout_draws": {"type": "integer", "minimum": 100, "maximum": 100000},
        "late_stage_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "defend_p1_tolerance": {"type": "number", "minimum": 0, "maximum": 1},
        "catch_up_p1_tolerance": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "weights"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 0.5}}
      }
    }
  }
}
