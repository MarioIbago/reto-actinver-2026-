{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reto-actinver-2026.local/schemas/alpha_ensemble_case.schema.json",
  "title": "M7 point-in-time ensemble calibration and evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "dataset_id", "dataset_sha256", "universe_version", "target", "transaction_cost_model_sha256", "horizon", "horizon_sessions", "evidence", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_sha256": {"$ref": "#/$defs/sha256"},
    "universe_version": {"type": "string", "minLength": 1},
    "target": {"const": "instrument_forward_return_net_of_costs"},
    "transaction_cost_model_sha256": {"$ref": "#/$defs/sha256"},
    "horizon": {"type": "string", "minLength": 1},
    "horizon_sessions": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_type", "source_times_verified", "instrument_mapping_verified", "execution_costs_verified", "final_holdout_locked", "source_manifest_sha256"],
      "properties": {
        "sample_type": {"enum": ["authorized_point_in_time", "synthetic_fixture"]},
        "source_times_verified": {"type": "boolean"},
        "instrument_mapping_verified": {"type": "boolean"},
        "execution_costs_verified": {"type": "boolean"},
        "final_holdout_locked": {"type": "boolean"},
        "source_manifest_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "instrument_id", "horizon_sessions", "decision_at_utc", "target_end_at_utc", "split", "regime", "regime_available_at_utc", "realized_return", "forecasts"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "horizon_sessions": {"type": "integer", "minimum": 1},
        "decision_at_utc": {"type": "string", "format": "date-time"},
        "target_end_at_utc": {"type": "string", "format": "date-time"},
        "split": {"enum": ["train", "validation", "test", "live"]},
        "regime": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "regime_available_at_utc": {"anyOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "realized_return": {"anyOf": [{"type": "null"}, {"type": "number"}]},
        "forecasts": {"type": "array", "items": {"$ref": "#/$defs/forecast"}}
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "available_at_utc", "raw_score", "q05", "q25", "q50", "q75", "q95", "p_positive"],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1},
        "available_at_utc": {"type": "string", "format": "date-time"},
        "raw_score": {"type": "number"},
        "q05": {"type": "number"},
        "q25": {"type": "number"},
        "q50": {"type": "number"},
        "q75": {"type": "number"},
        "q95": {"type": "number"},
        "p_positive": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
